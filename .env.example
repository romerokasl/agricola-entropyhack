# Plantilla de configuración. Copiar a .env.local y llenar con credenciales reales.
# .env.local está en .gitignore y NUNCA debe subirse al repo.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ML Microservicio local
ML_SERVICE_URL=http://localhost:8000

# Solo para `npm run db:migrate`: cadena de conexión Postgres del proyecto Supabase.
DATABASE_URL=

# LLM — LLM_PROVIDER: "gemini" u "ollama"
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=120000
# Obligatoria si LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Modo offline de respaldo para el pitch (lib/demo.ts). "1" lo activa; vacío, apagado.
DEMO_MODE=

# Voz speech-to-speech (voice/speech-to-speech/, ruta /s2s)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
OPENAI_REALTIME_TRANSCRIPCION=

# Pipeline de voz — STT_PROVIDER: "navegador" o "whisper"
STT_PROVIDER=navegador
# Rutas a los binarios locales (los instala `npm run voz:instalar` en voice/pipeline/bin/)
WHISPER_BIN=
WHISPER_MODELO=
PIPER_BIN=
PIPER_VOZ=

# TTS_PROVIDER: "google" (Cloud TTS), "edge" (gratis, sin credenciales),
#               "piper" (local) o "navegador" (SpeechSynthesis del cliente).
TTS_PROVIDER=google

# Voz de respaldo cuando Google falla y se cae a Edge.
TTS_VOZ=es-MX-JorgeNeural

# --- Google Cloud Text-to-Speech ---
# OJO: Google NO tiene voces es-SV ni es-MX. Para español solo publica es-ES
# (España) y es-US (latinoamericano neutro). Pedir "es-SV-*" devuelve HTTP 400.
#
# Masculinas es-US, de más a menos natural:
#   es-US-Chirp3-HD-Charon    (Chirp3 HD — la más humana)
#   es-US-Chirp3-HD-Algenib
#   es-US-Studio-B            (narración expresiva)
#   es-US-Neural2-B           (WaveNet Neural2)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_VOZ=es-US-Chirp3-HD-Charon

# El JSON de la cuenta de servicio, completo y en UNA sola línea.
# Consola → IAM → Cuentas de servicio → Claves → Crear clave → JSON.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

NEXT_PUBLIC_APP_URL=http://localhost:3000
