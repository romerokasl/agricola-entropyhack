# ====================================================================
# BANCOAGRÍCOLA ENTROPYHACK — ENVIRONMENT VARIABLES TEMPLATE
# ====================================================================

# 1. Supabase Configuration (Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (SOLO para Route Handlers del backend, NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Connection string de Postgres. Solo se usa para aplicar migraciones y el seed
# con psql (Project Settings → Database → Connection string).
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# 2. Machine Learning Inference Service (Python FastAPI)
# En local: http://localhost:8000
# En producción/demo: URL de Render, Railway o Modal
ML_SERVICE_URL=http://localhost:8000

# 3. LLM Orchestration (Para generación de mensajes empáticos dinámicos)
# Proveedor activo. Ver docs/contexto/03-seleccion-modelo-llm.md
# ollama = local, SIN cuota — usar durante desarrollo/pruebas para no quemar el tier
#          gratuito de Gemini. Requiere "ollama serve" corriendo y el modelo bajado
#          (ollama pull llama3.1).
# gemini = proveedor de demo/producción (tier gratuito de AI Studio) — cambiar a este
#          valor cuando el flujo ya esté optimizado y probado. Cambiar de proveedor es
#          cambiar esta línea, no código (ver lib/agent/llm.ts).
LLM_PROVIDER=ollama

# Usado solo si LLM_PROVIDER=ollama. Opcionales, con default sensato si se omiten.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Usado solo si LLM_PROVIDER=gemini. Primario de demo: Gemini Flash (tier gratuito, sin tarjeta)
GEMINI_API_KEY=your-gemini-api-key

# Fallback si Gemini agota su cupo en pleno demo (tier gratuito, sin tarjeta)
GROQ_API_KEY=your-groq-api-key

# Opcionales — solo si se migra a un proveedor pago.
# OJO: Claude Opus 5 / Sonnet 5 NO aceptan `temperature` (devuelven 400).
# Si se usa Claude y se quiere mantener temperature 0.2, usar Haiku 4.5 o 4.6.
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# 4. App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
